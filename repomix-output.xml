	border-color: transparent;

	&:hover:not(.app-button--disabled) {
		background-color: transparent;
		color: var(--brand-hover);
	}
}

.app-button__loader {
	position: absolute;
	top: 50%;
	left: 50%;
	width: var(--unit-4);
