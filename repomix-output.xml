		children: [
			{
				path: '',
				pathMatch: 'full',
				redirectTo: RouteSegments.FRONTEND,
			},
			{
				path: RouteSegments.FRONTEND,
				loadComponent: () =>
					import('@pages/course-page').then((c) => c.CoursePageComponent),
				children: [
					{
						path: '',
						redirectTo: 'overview',
						pathMatch: 'full',
					},
				],
			},
		],
	},

