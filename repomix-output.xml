function containsDuplicate(nums: number[]): boolean {
	const duplicatesSet = new Set();

	for (const elem of nums) {
		if (duplicatesSet.has(elem)) {
			return true;
		}
		duplicatesSet.add(elem);
	}

	return false;
}

